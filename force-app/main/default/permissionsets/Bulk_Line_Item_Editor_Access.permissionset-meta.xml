<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Bulk Line Item Editor Access</label>
    <description>Grants access to the Discount field and Apex controller used by the Bulk Line Item Editor.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <classAccesses>
        <apexClass>BulkLineItemEditorController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <fieldPermissions>
        <editable>true</editable>
        <field>OpportunityLineItem.Discount__c</field>
        <readable>true</readable>
    </fieldPermissions>
</PermissionSet>
